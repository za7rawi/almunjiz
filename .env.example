# ============================================
# AL-MUNJIZ Platform - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth (for "تسجيل عبر Google")
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Apple OAuth (for "تسجيل عبر Apple")
NEXT_PUBLIC_APPLE_CLIENT_ID=

# Stripe Payments (for online payment)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Database (only if using Prisma/PostgreSQL)
DATABASE_URL=

# OTP Provider (twilio | unifonic | taqnyat)
OTP_PROVIDER=twilio

# Twilio Verify
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# SMS OTP Providers (uncomment one)
# UNIFONIC_APP_KEY=
# TAQNYAT_API_KEY=
